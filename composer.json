{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "keneya/finance-caisse",
    "type": "library",
    "description": "Module Finance, Caisse et Facturation de Keneya — se monte dans une application Laravel hôte (Keneya Workflow).",
    "keywords": [
        "finance",
        "caisse",
        "facturation",
        "laravel",
        "module",
        "sante",
        "keneya"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0",
        "illuminate/support": "^12.0",
        "spatie/laravel-permission": "^6.0 || ^8.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "Keneya\\FinanceCaisse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Keneya\\FinanceCaisse\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Keneya\\FinanceCaisse\\FinanceServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench finance:demo-setup --ansi",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "serve:docker": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench finance:demo-setup --ansi",
            "@php vendor/bin/testbench serve --host=0.0.0.0 --ansi"
        ],
        "test": "@php vendor/bin/phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "version": "0.1.0"
}
